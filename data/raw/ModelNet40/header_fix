import os

raw_data_dir_root = "data/raw/ModelNet40"
categories = ["airplane", "car", "chair", "table", "sofa", "bed", "bookshelf", "desk", "dresser", "monitor"]
splits = ["train", "test"]

fixed_count = 0

for category in categories:
    for split in splits:
        folder = os.path.join(raw_data_dir_root, category, split)
        if not os.path.isdir(folder):
            continue
        for filename in os.listdir(folder):
            if not filename.endswith(".off"):
                continue
            filepath = os.path.join(folder, filename)
            with open(filepath, 'r') as f:
                content = f.read()

            if content.startswith("OFF") and not content.startswith("OFF "):

                new_content = "OFF " + content[3:]
                with open(filepath, 'w') as f:
                    f.write(new_content)
                fixed_count += 1

print(f"Fixed {fixed_count} OFF files.")